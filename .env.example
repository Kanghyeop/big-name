# 이 파일을 .env.local 로 복사해서 값을 채우세요.

# 어드민 비밀번호. 값이 없으면 어드민에 아무도 들어갈 수 없습니다.
# 신청자 연락처가 보이는 화면이니 배포 환경에서는 긴 값을 쓰세요.
ADMIN_PASSWORD=

# 카카오톡 채널 주소. 넣으면 랜딩 컨택트에 채널 버튼이 나타납니다.
# NEXT_PUBLIC_KAKAO_CHANNEL_URL=https://pf.kakao.com/_xxxxxx

# 도메인. OG 이미지 주소의 기준이 됩니다.
# NEXT_PUBLIC_SITE_URL=https://bigname.kr
